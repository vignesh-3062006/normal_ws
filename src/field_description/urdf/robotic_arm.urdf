<?xml version="1.0" ?>
<robot name="arm">

    <link name = "base_link"/>

    <link name="arm_base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
            <mesh filename="package://field_description/meshes/kfs_meshes/arm_base.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black">
            <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual>
    </link>

    <link name="arm_link_1">
        <visual>
            <origin xyz="-0.001 -0.3 0.098" rpy="1.57 3.14 3.14"/>
            <geometry>
            <mesh filename="package://field_description/meshes/kfs_meshes/arm_link_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white">
            <color rgba="0.9 0.9 0.9 1.0"/>
            </material>
        </visual>
    </link>

    <link name="arm_link_2">
        <visual>
            <origin xyz="0 -0.51 0.12" rpy="-1.57 0 0"/>
            <geometry>
            <mesh filename="package://field_description/meshes/kfs_meshes/arm_link_2.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white">
            <color rgba="0.9 0.9 0.9 1.0"/>
            </material>
        </visual>
    </link>

    <link name="gripper_base_link">
        <visual>
            <origin xyz="0 -0.73 0.12" rpy="-1.57 0 0"/>
            <geometry>
            <mesh filename="package://field_description/meshes/kfs_meshes/gripper_base.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="base_grey">
            <color rgba="0.6 0.6 0.6 1.0"/>
            </material>
        </visual>
    </link>

    <link name="gripper_left_link">
        <visual>
            <origin xyz="0.317 -0.826 0" rpy="0 1.57 1.57"/>
            <geometry>
            <mesh filename="package://field_description/meshes/kfs_meshes/gripper_left.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black">
            <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual>
    </link>
    
    <link name="gripper_right_link">
        <visual>
            <origin xyz="-0.076 -0.826 0" rpy="0 1.57 1.57"/>
            <geometry>
            <mesh filename="package://field_description/meshes/kfs_meshes/gripper_right.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black">
            <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual>
    </link>


    <joint name="base_link_joint" type="fixed">
        <parent link="base_link"/>
        <child link="arm_base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="arm_base_joint" type="revolute">
        <parent link="arm_base_link"/>
        <child link="arm_link_1"/>
        <origin xyz="0 0.1 0.3" rpy="1.57 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-2.09" upper="2.09" effort="10" velocity="1.0"/>
    </joint>


    <joint name="arm_link_joint" type="revolute">
        <parent link="arm_link_1"/>
        <child link="arm_link_2"/>
        <origin xyz="0 0.21 -0.02" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-2.09" upper="2.09" effort="10" velocity="1.0"/>
    </joint>

    <joint name="gripper_base_joint" type="revolute">
        <parent link="arm_link_2"/>
        <child link="gripper_base_link"/>
        <origin xyz="0 0.22 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <joint name="gripper_left_joint" type="revolute">
        <parent link="gripper_base_link"/>
        <child link="gripper_left_link"/>
        <origin xyz="0 0.12 -0.2" rpy="0 -1.57 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <joint name="gripper_right_joint" type="revolute">
        <parent link="gripper_base_link"/>
        <child link="gripper_right_link"/>
        <origin xyz="0 0.12 0.2" rpy="0 -1.57 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="1.57" effort="10" velocity="1.0"/>
        <mimic joint="gripper_left_joint" multiplier="-1" offset="0"/>
    </joint>

</robot>